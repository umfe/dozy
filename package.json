{
	"name": "dozy",
	"version": "1.0.40",
	"description": "My shared typescript utilities.",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json",
		"./reset": {
			"types": "./dist/assets/reset.d.ts",
			"default": "./dist/assets/reset.css"
		}
	},
	"files": [
		"dist",
		"assets",
		"README.md"
	],
	"scripts": {
		"clean": "rimraf dist",
		"build:types": "tsc -p tsconfig.json --emitDeclarationOnly --declaration --outDir dist",
		"build:types:bundle": "dts-bundle-generator -o dist/index.d.ts src/index.ts --inline-declare-externals --no-banner",
		"build:bundle": "esbuild src/index.ts --bundle --platform=browser --format=esm --target=es2020 --outfile=dist/index.js --sourcemap --minify",
		"build": "npm run clean && npm run build:types && npm run build:types:bundle && npm run build:bundle && node scripts/copy-assets.js",
		"prepare": "npm run build"
	},
	"author": "xaidozy",
	"license": "ISC",
	"devDependencies": {
		"@types/node": "^24.10.1",
		"dts-bundle-generator": "^9.5.1",
		"esbuild": "^0.18.18",
		"javascript-obfuscator": "^4.2.0",
		"rimraf": "^5.0.0",
		"typescript": "^5.4.2"
	},
	"dependencies": {
		"@types/crypto-js": "^4.2.2",
		"@types/culori": "^4.0.1",
		"@types/lodash-es": "^4.17.12",
		"axios": "^1.13.2",
		"browser-image-compression": "^2.0.2",
		"crypto-js": "^4.2.0",
		"culori": "^4.0.2",
		"lodash-es": "^4.17.22",
		"nanoid": "^5.1.6",
		"zod": "^4.2.1"
	}
}
