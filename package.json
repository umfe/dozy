{
	"name": "dozy",
	"version": "1.0.5",
	"description": "My shared typescript utilities.",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"node_modules"
	],
	"scripts": {
		"clean": "rimraf dist || rmdir /s /q dist",
		"build:plain": "npm run clean && tsc -p tsconfig.json",
		"build": "npm run build:plain && node scripts/obfuscate.cjs",
		"prepare": "npm run build"
	},
	"author": "xaidozy",
	"license": "ISC",
	"devDependencies": {
		"@types/node": "^24.10.1",
		"javascript-obfuscator": "^4.2.0",
		"rimraf": "^5.0.0",
		"typescript": "^5.4.2"
	},
	"dependencies": {
		"@types/crypto-js": "^4.2.2",
		"@types/lodash": "^4.17.21",
		"axios": "^1.13.2",
		"crypto-js": "^4.2.0",
		"lodash": "^4.17.21",
		"nanoid": "^5.1.6"
	}
}
